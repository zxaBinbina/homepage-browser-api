{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bin-api",
  "main": "src/index.ts",
  "account_id": "8132f8d4a7abd8f167ca128689b18df0",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "api.zxabinbina.cc.cd", "custom_domain": true },
    { "pattern": "browse.zxabinbina.cc.cd", "custom_domain": true },
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "observability": { "enabled": false },
  "vars": {
    "API_ORIGIN": "https://api.zxabinbina.cc.cd",
    "BROWSE_ORIGIN": "https://browse.zxabinbina.cc.cd",
    "HOME_ORIGIN": "https://zxabinbina.cc.cd",
    "SESSION_SECONDS": "3600",
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "PROXY_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 1500, "period": 60 },
    },
  ],
}
